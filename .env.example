# Appwrite — copy to .env and fill with your Appwrite project values.
# Expo loads .env on start; only EXPO_PUBLIC_* are available in the app.

EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT=your-project-id

EXPO_PUBLIC_APPWRITE_DATABASE=gastrack

# For npm run appwrite:setup (server only). Create in Console: API Key with
# databases (read+write), collections (read+write), attributes (read+write). Do not commit.
# APPWRITE_API_KEY=
EXPO_PUBLIC_APPWRITE_COLLECTION_CUSTOMERS=customers
EXPO_PUBLIC_APPWRITE_COLLECTION_CYLINDER_TYPES=cylinder_types
EXPO_PUBLIC_APPWRITE_COLLECTION_INVENTORY=inventory
EXPO_PUBLIC_APPWRITE_COLLECTION_MOVEMENTS=movements
EXPO_PUBLIC_APPWRITE_COLLECTION_CUSTOMER_OWED=customer_owed
EXPO_PUBLIC_APPWRITE_COLLECTION_PRICES=prices
EXPO_PUBLIC_APPWRITE_COLLECTION_FINANCE_TRANSACTIONS=finance_transactions
EXPO_PUBLIC_APPWRITE_COLLECTION_CUSTOMER_BALANCE=customer_balance
